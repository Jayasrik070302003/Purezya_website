# ==========================================
# PURAZYA BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5001
NODE_ENV=production

# Database (Neon PostgreSQL Connection URL)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-YOUR-PROJECT.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Secret
JWT_SECRET=your_super_secure_random_jwt_secret_key_here

# Cloudinary Cloud Storage (For Product & Profile Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=your_brevo_v3_api_key_here
SENDER_EMAIL=support@purazya.com
SENDER_NAME=Purazya Organic Foods
